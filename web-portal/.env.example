APP_ENV=production
APP_URL=https://easypdf.asteritilfa.it
APP_SECRET=replace-with-at-least-32-random-characters
# Facoltativo: client OIDC/PKCE autorizzato per "Accedi con ChatGPT".
OPENAI_CLIENT_ID=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=easypdf
DB_USER=easypdf
DB_PASSWORD=replace-me
EASYPDF_CLI=/home/USER/domains/easypdf.asteritilfa.it/bin/easypdf-cli
EASYPDF_STORAGE=/home/USER/domains/easypdf.asteritilfa.it/storage
MAX_UPLOAD_MB=200
# Solo sviluppo/test; seed-test-data.php è disabilitato in produzione.
TEST_PASSWORD=EasyPDF-Test-2026!
# Mittente usato per il recupero password. Configurare anche il trasporto mail del server.
MAIL_FROM=noreply@easypdf.asteritilfa.it
# Destinatario iniziale dei messaggi di supporto. Il Super Admin può sostituirlo dalla pagina Supporto.
SUPPORT_EMAIL=
# Collegamenti diretti ai pacchetti compilati; se vuoti viene usata la pagina delle release GitHub.
DOWNLOAD_WINDOWS_URL=
DOWNLOAD_MACOS_URL=
DOWNLOAD_LINUX_URL=
